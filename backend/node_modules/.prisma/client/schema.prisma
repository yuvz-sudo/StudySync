// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------
// 1. User Model
// ------------------------------------------
model User {
  id            BigInt    @id @default(autoincrement())
  username      String    @unique @db.VarChar(50)
  email         String    @unique @db.VarChar(255)
  passwordHash  String    @map("password_hash") @db.VarChar(255)
  currentStreak Int       @default(0) @map("current_streak")
  longestStreak Int       @default(0) @map("longest_streak")
  lastActiveAt  DateTime? @map("last_active_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relationships
  settings               UserSettings?
  subjects               Subject[]
  studySessions          StudySession[]
  friends1               Friend[]           @relation("User1")
  friends2               Friend[]           @relation("User2")
  sentFriendRequests     FriendRequest[]    @relation("Sender")
  receivedFriendRequests FriendRequest[]    @relation("Receiver")
  notifications          Notification[]
  mailLogs               MailLog[]
  dailySummaries         UserDailySummary[]

  @@map("users")
}

// ------------------------------------------
// 2. UserSettings Model (1:1 with User)
// ------------------------------------------
model UserSettings {
  userId                      BigInt   @id @map("user_id")
  dailyStudyGoalSeconds       Int      @default(7200) @map("daily_study_goal_seconds")
  isEmailNotificationsEnabled Boolean  @default(true) @map("is_email_notifications_enabled")
  isPushNotificationsEnabled  Boolean  @default(true) @map("is_push_notifications_enabled")
  theme                       String   @default("dark") @db.VarChar(20)
  createdAt                   DateTime @default(now()) @map("created_at")
  updatedAt                   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

// ------------------------------------------
// 3. Subject Model
// ------------------------------------------
model Subject {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @map("user_id")
  name      String   @db.VarChar(100)
  colorCode String   @default("#3B82F6") @map("color_code") @db.Char(7)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  studySessions  StudySession[]
  dailySummaries UserDailySummary[]

  @@unique([userId, name], name: "uq_user_subject_name")
  @@map("subjects")
}

// ------------------------------------------
// 4. StudySession Model
// ------------------------------------------
model StudySession {
  id              BigInt        @id @default(autoincrement())
  userId          BigInt        @map("user_id")
  subjectId       BigInt        @map("subject_id")
  startTime       DateTime      @map("start_time")
  endTime         DateTime?     @map("end_time")
  durationSeconds Int?          @map("duration_seconds")
  status          SessionStatus @default(ACTIVE)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  @@map("study_sessions")
}

enum SessionStatus {
  ACTIVE
  PAUSED
  COMPLETED
}

// ------------------------------------------
// 5. Friend Model (Junction for self-reference)
// ------------------------------------------
model Friend {
  userId1       BigInt   @map("user_id_1")
  userId2       BigInt   @map("user_id_2")
  establishedAt DateTime @default(now()) @map("established_at")

  user1 User @relation("User1", fields: [userId1], references: [id], onDelete: Cascade)
  user2 User @relation("User2", fields: [userId2], references: [id], onDelete: Cascade)

  @@id([userId1, userId2])
  @@map("friends")
}

// ------------------------------------------
// 6. FriendRequest Model
// ------------------------------------------
model FriendRequest {
  id         BigInt        @id @default(autoincrement())
  senderId   BigInt        @map("sender_id")
  receiverId BigInt        @map("receiver_id")
  status     RequestStatus @default(PENDING)
  sentAt     DateTime      @default(now()) @map("sent_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  sender   User @relation("Sender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("Receiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId], name: "uq_sender_receiver")
  @@map("friend_requests")
}

enum RequestStatus {
  PENDING
  ACCEPTED
  DECLINED
}

// ------------------------------------------
// 7. Notification Model
// ------------------------------------------
model Notification {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @map("user_id")
  title     String   @db.VarChar(150)
  message   String   @db.Text
  type      String   @db.VarChar(50)
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

// ------------------------------------------
// 8. MailLog Model
// ------------------------------------------
model MailLog {
  id             BigInt     @id @default(autoincrement())
  userId         BigInt?    @map("user_id")
  recipientEmail String     @map("recipient_email") @db.VarChar(255)
  subject        String     @db.VarChar(255)
  templateName   String     @map("template_name") @db.VarChar(50)
  status         MailStatus @default(PENDING)
  errorMessage   String?    @map("error_message") @db.Text
  sentAt         DateTime   @default(now()) @map("sent_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("mail_logs")
}

enum MailStatus {
  SENT
  FAILED
  PENDING
}

// ------------------------------------------
// 9. UserDailySummary Model (Analytics Roll-up)
// ------------------------------------------
model UserDailySummary {
  id                   BigInt   @id @default(autoincrement())
  userId               BigInt   @map("user_id")
  subjectId            BigInt   @map("subject_id")
  studyDate            DateTime @map("study_date") @db.Date
  totalDurationSeconds Int      @default(0) @map("total_duration_seconds")
  sessionsCount        Int      @default(0) @map("sessions_count")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([userId, subjectId, studyDate], name: "uq_user_subject_date")
  @@map("user_daily_summaries")
}
